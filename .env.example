# ═══════════════════════════════════════════════════════════════════════════════
# Aula Check — Variables de Entorno de Ejemplo
# ═══════════════════════════════════════════════════════════════════════════════

# Base de datos PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"

# Secreto HMAC-SHA256 para firmar cookies de sesión HTTP-only.
# OBLIGATORIO en producción (mínimo 32 caracteres); sin él el login responde 500.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="reemplaza-con-un-secreto-aleatorio-seguro-de-32-caracteres"

# URL pública de la app (se usa para los enlaces de los correos). Opcional.
APP_URL="https://aula-check-sooty.vercel.app"

# ─── Notificaciones por correo electrónico ────────────────────────────────────
# Prioridad: 1) Resend (si RESEND_API_KEY existe)  2) SMTP/Nodemailer  3) Desactivado.
# Si no configuras ninguno, la app funciona igual y solo registra en consola los correos omitidos.

# Remitente de los correos. Con Resend debe pertenecer a un dominio verificado.
MAIL_FROM="Aula Check <no-reply@tu-dominio.edu.co>"

# Opción A — Resend (https://resend.com/api-keys)
RESEND_API_KEY=""

# Opción B — SMTP (Gmail con contraseña de aplicación, Outlook, Mailtrap, SES...)
SMTP_HOST=""
SMTP_PORT="587"
# "true" para TLS implícito (puerto 465); por defecto se deduce del puerto.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Umbral del Semáforo de Permanencia para alertas de inasistencia (porcentaje, por defecto 75).
ATTENDANCE_RISK_THRESHOLD="75"

# ─── Autenticación Híbrida OpenLDAP / Directorio Activo ───────────────────────
# Establecer en "true" para priorizar autenticación contra OpenLDAP con fallback a PostgreSQL.
# Si se deja en "false" o el servidor LDAP no responde en 3000ms, usa PostgreSQL automáticamente.
LDAP_ENABLED="false"

# URL del servidor OpenLDAP (Tailscale: 100.76.207.99 | LAN: 192.168.0.15 | Túnel LDAPS para Vercel)
LDAP_URL="ldap://100.76.207.99:389"

# Base Distinguished Name del directorio institucional
LDAP_BASE_DN="dc=aulacheck,dc=edu,dc=co"

# Cuenta de servicio (Bind DN) con permisos de lectura para buscar usuarios por correo/uid
LDAP_BIND_DN="cn=admin,dc=aulacheck,dc=edu,dc=co"
LDAP_BIND_PASSWORD="reemplaza-con-la-clave-de-la-cuenta-de-servicio"

