// ═══════════════════════════════════════════════════════════════════════════════
// Aula Check — Esquema de Base de Datos Institucional
// Prisma ORM + PostgreSQL
// ═══════════════════════════════════════════════════════════════════════════════
// Este esquema modela la estructura relacional completa del sistema de
// asistencia académica "Aula Check". Incluye gestión de usuarios con roles
// institucionales, cursos, grupos, inscripciones, sesiones de clase,
// registros de asistencia y justificaciones de inasistencia (Art. 42).
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

/// Rol institucional del usuario dentro de la plataforma.
enum UserRole {
  TEACHER
  STUDENT
  ADMIN
}

/// Estado de una sesión de clase: activa o cerrada.
enum SessionStatus {
  ACTIVE
  CLOSED
}

/// Estado de asistencia individual en una sesión.
/// - PRESENTE: registrado por PIN/QR dentro del tiempo de tolerancia.
/// - PRESENTE_MANUAL: validado manualmente por el docente (contingencia).
/// - AUSENTE: no registró asistencia y no tiene justificación aprobada.
/// - JUSTIFICADO: ausencia justificada y aprobada según Art. 42.
enum AttendanceStatus {
  PRESENTE
  PRESENTE_MANUAL
  AUSENTE
  JUSTIFICADO
}

/// Motivo de la justificación de inasistencia (Art. 42 - Reglamento Estudiantil).
enum JustificationReason {
  MEDICO
  LABORAL
  FUERZA_MAYOR
}

/// Estado de revisión de una solicitud de justificación.
enum JustificationStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ─── Modelos ────────────────────────────────────────────────────────────────────

/// Usuario del sistema. Puede ser docente, estudiante o administrador.
/// El email debe ser institucional (@universidad.edu.co) y el código
/// institucional identifica de forma única al usuario dentro de la institución.
model User {
  id                String   @id @default(cuid())
  email             String   @unique /// Email institucional (@universidad.edu.co)
  name              String   /// Nombre completo del usuario
  role              UserRole /// Rol: TEACHER, STUDENT o ADMIN
  institutionalCode String   @unique /// Código estudiantil o de empleado

  createdAt DateTime @default(now())

  // ── Relaciones ──
  /// Grupos que imparte como docente (solo aplica si role = TEACHER)
  taughtGroups Group[] @relation("TeacherGroups")

  /// Inscripciones como estudiante (solo aplica si role = STUDENT)
  enrollments Enrollment[]

  /// Registros de asistencia del estudiante
  attendanceRecords AttendanceRecord[]

  /// Justificaciones enviadas por el estudiante
  justifications Justification[] @relation("StudentJustifications")

  /// Justificaciones revisadas como docente/admin
  reviewedJustifications Justification[] @relation("ReviewerJustifications")

  // ── Índices ──
  @@index([role])
  @@index([institutionalCode])
  @@map("users")
}

/// Asignatura o materia del plan de estudios.
/// Cada curso tiene un código único y puede tener un aula predeterminada.
model Course {
  id          String  @id @default(cuid())
  code        String  @unique /// Código de la asignatura (ej: "IS-401")
  name        String  /// Nombre completo de la asignatura
  defaultRoom String? /// Aula predeterminada (ej: "G-401")

  // ── Relaciones ──
  groups Group[]

  @@map("courses")
}

/// Grupo de una asignatura en un periodo académico específico.
/// Vincula un curso con un docente y define horario y periodo.
model Group {
  id        String @id @default(cuid())
  courseId  String /// FK al curso
  teacherId String /// FK al docente responsable
  term      String /// Periodo académico (ej: "2025-1", "2025-2")
  schedule  String /// Horario descriptivo (ej: "Lun/Mié 7:00-8:30")

  // ── Relaciones ──
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   User   @relation("TeacherGroups", fields: [teacherId], references: [id])

  enrollments   Enrollment[]
  classSessions ClassSession[]

  // ── Índices ──
  @@index([courseId])
  @@index([teacherId])
  @@index([term])
  @@map("groups")
}

/// Inscripción de un estudiante en un grupo específico.
/// Permite calcular el porcentaje de asistencia acumulado al final del periodo.
model Enrollment {
  id        String @id @default(cuid())
  studentId String /// FK al estudiante inscrito
  groupId   String /// FK al grupo

  /// Porcentaje de asistencia acumulado (0.00 – 100.00).
  /// Se actualiza al cerrar cada sesión. NULL hasta la primera sesión.
  finalAttendancePercentage Float?

  // ── Relaciones ──
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // ── Restricción: un estudiante solo puede inscribirse una vez por grupo ──
  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
  @@map("enrollments")
}

/// Sesión de clase individual. Creada cuando el docente inicia la toma de
/// asistencia. Contiene el PIN activo, tolerancia y estado de la sesión.
model ClassSession {
  id               String        @id @default(cuid())
  groupId          String        /// FK al grupo
  pin              String        /// PIN de 6 dígitos para registro de asistencia
  pinExpiresAt     DateTime      /// Expiración del PIN actual
  topic            String?       /// Tema desarrollado en la sesión
  room             String?       /// Aula donde se imparte la clase
  toleranceMinutes Int           @default(15) /// Minutos de tolerancia para tardanza
  status           SessionStatus @default(ACTIVE) /// ACTIVE o CLOSED

  startedAt DateTime  @default(now()) /// Hora de inicio de la sesión
  endedAt   DateTime? /// Hora de cierre (NULL si aún está activa)

  // ── Relaciones ──
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  attendanceRecords AttendanceRecord[]
  justifications    Justification[]

  // ── Índices ──
  @@index([groupId])
  @@index([status])
  @@index([pin])
  @@map("class_sessions")
}

/// Registro individual de asistencia de un estudiante a una sesión de clase.
/// Captura el estado, hora de registro y observaciones opcionales.
model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String           /// FK a la sesión de clase
  studentId String           /// FK al estudiante
  status    AttendanceStatus /// PRESENTE, PRESENTE_MANUAL, AUSENTE, JUSTIFICADO
  timestamp DateTime         @default(now()) /// Momento del check-in
  notes     String?          /// Observaciones (ej: "Validado por contingencia técnica")

  // ── Relaciones ──
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // ── Restricción: un estudiante solo puede tener un registro por sesión ──
  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@map("attendance_records")
}

/// Solicitud de justificación de inasistencia (Art. 42 del Reglamento Estudiantil).
/// Un estudiante puede justificar su ausencia adjuntando soporte documental.
/// El docente o administrador aprueba o rechaza la solicitud.
model Justification {
  id            String              @id @default(cuid())
  studentId     String              /// FK al estudiante solicitante
  sessionId     String              /// FK a la sesión de la ausencia
  reason        JustificationReason /// MEDICO, LABORAL o FUERZA_MAYOR
  description   String              /// Descripción detallada de la justificación
  attachmentUrl String?             /// URL del soporte documental (certificado médico, etc.)

  status     JustificationStatus @default(PENDIENTE) /// PENDIENTE, APROBADO o RECHAZADO
  reviewedAt DateTime?           /// Fecha/hora de revisión
  reviewedBy String?             /// FK al docente/admin que revisó la solicitud

  createdAt DateTime @default(now())

  // ── Relaciones ──
  student  User         @relation("StudentJustifications", fields: [studentId], references: [id], onDelete: Cascade)
  session  ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer User?        @relation("ReviewerJustifications", fields: [reviewedBy], references: [id])

  // ── Índices ──
  @@index([studentId])
  @@index([sessionId])
  @@index([status])
  @@map("justifications")
}
